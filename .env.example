# Which chat-model provider to run on: "groq" or "anthropic".
LLM_PROVIDER=groq

# Required when LLM_PROVIDER=groq. Free key from https://console.groq.com/keys
GROQ_API_KEY=

# Required when LLM_PROVIDER=anthropic. Key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Leave unset to use the provider's default model.
#   groq      -> llama-3.3-70b-versatile
#   anthropic -> claude-opus-5
# Groq rotates its model catalogue; if a model ID 404s, check
# https://console.groq.com/docs/models for the current list.
# The critic should be at least as capable as the generator, since it has to
# catch mistakes subtler than the ones the generator makes.
# GENERATION_MODEL=
# CRITIC_MODEL=

# Local, offline HuggingFace embedding model.
EMBEDDING_MODEL=BAAI/bge-m3

CHROMA_DIR=chroma_db

TOP_K=4
MAX_ATTEMPTS=3

CHUNK_SIZE=800
CHUNK_OVERLAP=120
